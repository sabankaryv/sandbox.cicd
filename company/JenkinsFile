//1.
pipeline
{
    agent any
    stages
    {
        stage('checkout')
        {
            steps
            {
             git branch:"sandbox.cicd",
             url:"https://github.com/sabankaryv/sandbox.cicd.git"   
            }
        }
        stage('test')
        {
            steps
            {
                sh 'cd company/ && python3 --version'
                sh 'cd company/ && python3 -m venv venv'
                sh 'cd company/ && venv/bin/pip install -r requirements.txt'
                sh 'cd company/ && venv/bin/python manage.py check'
            }
        }
        stage('build')
        {
            steps
            {
                sh 'cd company/ && venv/bin/python manage.py check'
                sh 'cd company/ && zip -r ../django-build.zip . -x "venv/*"'
                echo "Django Build Completed"
            }
        }
    }
    post
    {
        success
        {
            echo "SUCCESS"
            archiveArtifacts artifacts: 'django-build.zip'
        }
        failure
        {
            echo "Failure"
        }
    }
}

